<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash. Without these items the system shows the
         launcher icon in a white adaptive-icon shape. The logo has a
         transparent background, and the colour matches the light theme. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#FAFAFA</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
