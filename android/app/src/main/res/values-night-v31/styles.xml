<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash in dark mode. The colour matches the app's
         dark background (AppTheme darkBackground, #121212). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#121212</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
